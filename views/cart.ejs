<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Shopping Cart - Apna Store</title>
  <style>
    body { font-family: sans-serif; margin: 0; background-color: #f4f6f8; }
    header { background: #1f2937; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
    header a { color: white; text-decoration: none; font-weight: bold; }
    .container { max-width: 900px; margin: 30px auto; padding: 0 20px; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
    th, td { padding: 14px; text-align: left; border-bottom: 1px solid #eee; }
    th { background: #e5e7eb; font-size: 14px; }
    .cart-img { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; vertical-align: middle; margin-right: 10px; }
    .total-box { background: white; padding: 20px; border-radius: 8px; text-align: right; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .btn-checkout { background: #16a34a; color: white; padding: 12px 24px; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; text-decoration: none; display: inline-block; font-weight: bold; margin-top: 10px; }
    .btn-remove { color: #dc2626; text-decoration: none; font-size: 14px; }
  </style>
</head>
<body>

  <header>
    <h2>🛒 Your Cart</h2>
    <a href="/">← Continue Shopping</a>
  </header>

  <div class="container">
    <% if (!cart || cart.items.length === 0) { %>
      <div style="background: white; padding: 40px; text-align: center; border-radius: 8px;">
        <h3>Aapka cart khali hai!</h3>
        <p>Products dekhne ke liye store par wapis jayein.</p>
        <a href="/" style="color: #2563eb; font-weight: bold; text-decoration: none;">Store par jayein</a>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% cart.items.forEach(item => { %>
            <tr>
              <td>
                <img src="<%= item.imageUrl %>" class="cart-img" alt="<%= item.title %>">
                <b><%= item.title %></b>
              </td>
              <td>₹<%= item.price %></td>
              <td><%= item.quantity %></td>
              <td>₹<%= item.price * item.quantity %></td>
              <td>
                <a href="/cart/remove/<%= item.productId %>" class="btn-remove">Remove</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="total-box">
        <h3>Total Bill: ₹<%= cart.totalPrice %></h3>
        <a href="/checkout" class="btn-checkout">Proceed to Checkout (COD)</a>
      </div>
    <% } %>
  </div>

</body>
</html>