<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.title %> - Apna Store</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Product Detail Specific Animations & Layout */
    .detail-container {
      max-width: 1200px;
      margin: 25px auto;
      padding: 0 16px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      animation: fadeInUp 0.4s ease-out;
    }

    /* Left Gallery */
    .gallery-section {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .main-image-card {
      width: 100%;
      height: 480px;
      background: white;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .main-image-card img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      transition: transform 0.3s ease, opacity 0.25s ease;
    }

    .main-image-card:hover img {
      transform: scale(1.04);
    }

    .thumbnail-row {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding-bottom: 6px;
    }

    .thumb-box {
      width: 72px;
      height: 72px;
      border-radius: 10px;
      border: 2px solid #e2e8f0;
      overflow: hidden;
      cursor: pointer;
      background: white;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .thumb-box.active {
      border-color: #2563eb;
      transform: scale(1.05);
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
    }

    .thumb-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Right Info Details */
    .info-section {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .product-badge {
      display: inline-block;
      align-self: flex-start;
      background: #eff6ff;
      color: #2563eb;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 20px;
      letter-spacing: 0.5px;
    }

    .product-title {
      font-size: 26px;
      font-weight: 700;
      color: #0f172a;
      line-height: 1.3;
    }

    .rating-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #15803d;
      color: white;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      width: fit-content;
    }

    .price-box {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin: 8px 0;
    }

    .price-box .price {
      font-size: 28px;
      font-weight: 800;
      color: #0f172a;
    }

    .price-box .mrp {
      font-size: 16px;
      color: #94a3b8;
      text-decoration: line-through;
    }

    .discount-tag {
      color: #16a34a;
      font-weight: 700;
      font-size: 14px;
    }

    /* Interactive Size Boxes */
    .size-title {
      font-size: 14px;
      font-weight: 700;
      color: #334155;
      margin-bottom: 8px;
    }

    .size-boxes {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .size-chip {
      min-width: 46px;
      height: 46px;
      padding: 0 14px;
      border-radius: 8px;
      border: 1.5px solid #cbd5e1;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 600;
      color: #334155;
      cursor: pointer;
      user-select: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .size-chip:hover {
      border-color: #2563eb;
      color: #2563eb;
      transform: translateY(-2px);
    }

    .size-chip.selected {
      background: #2563eb;
      color: white;
      border-color: #2563eb;
      transform: scale(1.08);
      box-shadow: 0 4px 10px rgba(37, 99, 235, 0.35);
    }

    /* Action Buttons (Desktop) */
    .cta-actions {
      display: flex;
      gap: 14px;
      margin-top: 15px;
    }

    .btn-add-cart {
      flex: 1;
      padding: 14px;
      border-radius: 10px;
      background: white;
      border: 2px solid #2563eb;
      color: #2563eb;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-add-cart:hover {
      background: #eff6ff;
      transform: translateY(-2px);
    }

    /* Feature Highlights */
    .perks-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      background: #f8fafc;
      padding: 14px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      margin-top: 10px;
    }

    .perk-item {
      font-size: 13px;
      font-weight: 500;
      color: #475569;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Mobile Sticky Bottom Floating Bar */
    .mobile-sticky-action {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      padding: 12px 16px;
      box-shadow: 0 -4px 15px rgba(0,0,0,0.08);
      z-index: 1000;
    }

    .mobile-sticky-btn {
      width: 100%;
      background: #2563eb;
      color: white;
      border: none;
      padding: 14px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }

    /* Responsive Queries */
    @media (max-width: 768px) {
      .detail-container {
        grid-template-columns: 1fr;
        gap: 20px;
        padding-bottom: 80px;
      }
      .main-image-card {
        height: 360px;
      }
      .cta-actions {
        display: none; /* Desktop button hide karke sticky float bar layenge */
      }
      .mobile-sticky-action {
        display: block;
      }
    }
  </style>
</head>
<body>

  <!-- Top Simple Navigation Header -->
  <header class="navbar">
    <a href="/" class="brand-logo">🛍️ Apna Store</a>
    <div class="nav-actions">
      <a href="/cart" class="nav-btn btn-primary">
        🛒 Cart <span class="cart-badge"><%= cartCount %></span>
      </a>
      <a href="/" class="nav-btn" style="border: 1px solid #cbd5e1; color: #475569;">← Back to Shop</a>
    </div>
  </header>

  <main class="detail-container">
    <!-- Left: Image Gallery -->
    <section class="gallery-section">
      <div class="main-image-card">
        <% 
          let defaultImg = (product.images && product.images.length > 0) ? product.images[0] : (product.imageUrl || 'https://via.placeholder.com/400');
        %>
        <img id="primaryImage" src="<%= defaultImg %>" alt="<%= product.title %>">
      </div>

      <% if (product.images && product.images.length > 1) { %>
        <div class="thumbnail-row">
          <% product.images.forEach((img, idx) => { %>
            <div class="thumb-box <%= idx === 0 ? 'active' : '' %>" onclick="switchImage('<%= img %>', this)">
              <img src="<%= img %>" alt="preview">
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Right: Product Information & Selection -->
    <section class="info-section">
      <span class="product-badge"><%= product.category %> Wear</span>
      <h1 class="product-title"><%= product.title %></h1>
<% if (isAdmin) { %>
  <!-- Admin Quick Actions Bar -->
  <div style="display: flex; align-items: center; gap: 10px; margin: 12px 0; background: #fef2f2; border: 1px solid #fee2e2; padding: 10px 14px; border-radius: 8px;">
    <span style="font-size: 13px; font-weight: 700; color: #991b1b;">Admin Panel:</span>
    <a href="/admin/edit-product/<%= product._id %>" style="background: #2563eb; color: white; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 600;">✏️ Edit Product</a>
    
    <form action="/admin/delete-product/<%= product._id %>" method="POST" onsubmit="return confirm('Kya aap sach me is product ko delete karna chahte hain?');" style="margin: 0;">
      <button type="submit" style="background: #dc2626; color: white; border: none; padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600;">🗑️ Delete</button>
    </form>
  </div>
<% } %>
      <div class="rating-badge">
        ★ <%= (product.avgRating || 4.2).toFixed(1) %> | <%= product.reviews ? product.reviews.length : 12 %> Ratings
      </div>

      <div class="price-box">
        <span class="price">₹<%= product.price %></span>
        <% if (product.originalPrice) { %>
          <span class="mrp">₹<%= product.originalPrice %></span>
          <% let off = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100); %>
          <span class="discount-tag">(<%= off %>% OFF)</span>
        <% } %>
      </div>

      <!-- Size Selection Form -->
      <form id="addToCartForm" action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product._id %>">
        <input type="hidden" name="selectedSize" id="selectedSizeInput" value="">

        <% if (product.sizes && product.sizes.length > 0) { %>
          <div style="margin: 15px 0;">
            <div class="size-title">Select Size:</div>
            <div class="size-boxes">
              <% product.sizes.forEach(size => { %>
                <div class="size-chip" onclick="selectSize('<%= size %>', this)">
                  <%= size %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <div class="cta-actions">
          <button type="button" class="btn-add-cart" onclick="submitCartForm()">
            🛒 Add to Cart
          </button>
        </div>
      </form>

      <!-- Trust Badges / Perks -->
      <div class="perks-grid">
        <div class="perk-item">⚡ Fast 3-Day Delivery</div>
        <div class="perk-item">🔄 7 Days Easy Returns</div>
        <div class="perk-item">🔒 100% Secure Checkout</div>
        <div class="perk-item">✨ Guaranteed Quality</div>
      </div>

      <!-- Description -->
      <div style="margin-top: 15px;">
        <h4 style="font-size: 15px; color: #1e293b; margin-bottom: 6px;">Description & Care</h4>
        <p style="font-size: 14px; color: #64748b; line-height: 1.6;">
          <%= product.description || "Premium quality fabric crafted for perfect comfort and long-lasting durability. Machine washable and shrink-resistant." %>
        </p>
      </div>
    </section>
  </main>

  <!-- Sticky Add to Cart for Mobile Screens -->
  <div class="mobile-sticky-action">
    <button type="button" class="mobile-sticky-btn" onclick="submitCartForm()">
      🛒 Add to Cart • ₹<%= product.price %>
    </button>
  </div>

  <script>
    // Smooth Thumbnail Switching
    function switchImage(src, thumbElement) {
      const mainImg = document.getElementById('primaryImage');
      mainImg.style.opacity = '0';
      
      setTimeout(() => {
        mainImg.src = src;
        mainImg.style.opacity = '1';
      }, 150);

      document.querySelectorAll('.thumb-box').forEach(el => el.classList.remove('active'));
      thumbElement.classList.add('active');
    }

    // Size Selection Logic
    function selectSize(size, element) {
      document.getElementById('selectedSizeInput').value = size;
      document.querySelectorAll('.size-chip').forEach(el => el.classList.remove('selected'));
      element.classList.add('selected');
    }

    // Validate size before cart submit
    function submitCartForm() {
      const sizeInput = document.getElementById('selectedSizeInput');
      const sizeBoxes = document.querySelectorAll('.size-chip');

      if (sizeBoxes.length > 0 && !sizeInput.value) {
        alert('⚠️ Kripya pehle apna size select karein!');
        return;
      }

      document.getElementById('addToCartForm').submit();
    }
  </script>

</body>
</html>