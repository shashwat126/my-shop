<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🛍️ Apna Store</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Glass Navbar -->
  <header class="navbar">
    <a href="/" class="brand-logo">🛍️ Apna Store</a>

    <div class="search-container">
      <span class="search-icon">🔍</span>
      <form action="/" method="GET">
        <input type="text" name="search" placeholder="Search clothes, shoes, items..." value="<%= searchQuery || '' %>">
      </form>
    </div>

    <!-- Desktop Action Buttons -->
    <div class="nav-actions">
      <a href="/cart" class="nav-btn btn-primary">
        🛒 Cart <span class="cart-badge"><%= cartCount %></span>
      </a>

      <% if (currentUser) { %>
        <span style="font-size: 14px; font-weight: 600;">Hi, <%= currentUser.name %></span>
        <% if (isAdmin) { %>
          <a href="/admin/add-product" class="nav-btn" style="background:#0f172a; color:white;">+ Add Item</a>
          <a href="/admin/orders" class="nav-btn" style="background:#e2e8f0; color:#0f172a;">Orders</a>
        <% } %>
        <a href="/logout" class="nav-btn" style="color: #ef4444;">Logout</a>
      <% } else { %>
        <a href="/login" class="nav-btn" style="border: 1px solid #cbd5e1; color: #334155;">Login</a>
        <a href="/signup" class="nav-btn btn-primary">Sign Up</a>
      <% } %>
    </div>
  </header>

  <!-- Horizontal Scrollable Categories -->
  <div class="category-scroll">
    <a href="/" class="pill <%= currentCategory === 'all' ? 'active' : '' %>">All Items</a>
    <a href="/?category=men" class="pill <%= currentCategory === 'men' ? 'active' : '' %>">Men's Wear</a>
    <a href="/?category=women" class="pill <%= currentCategory === 'women' ? 'active' : '' %>">Women's Wear</a>
    <a href="/?category=kids" class="pill <%= currentCategory === 'kids' ? 'active' : '' %>">Kids Fashion</a>
  </div>

  <!-- Responsive Product Grid -->
  <main class="product-grid">
    <% if (products.length === 0) { %>
      <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
        <h3>Koi product nahi mila!</h3>
        <p style="color: #64748b;">Dusri category ya search try karein.</p>
      </div>
    <% } %>

    <% products.forEach(p => { %>
      <div class="product-card" onclick="window.location.href='/product/<%= p._id %>'">
        <div class="card-img-wrapper">
          <img src="<%= (p.images && p.images.length > 0) ? p.images[0] : (p.imageUrl || 'https://via.placeholder.com/300') %>" alt="<%= p.title %>" loading="lazy">
        </div>
        <div class="card-body">
          <h3 class="card-title"><%= p.title %></h3>
          <div class="price-row">
            <span class="current-price">₹<%= p.price %></span>
            <% if (p.originalPrice) { %>
              <span class="old-price">₹<%= p.originalPrice %></span>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </main>

  <!-- Mobile Bottom Floating Navigation Bar -->
  <nav class="mobile-bottom-nav">
    <a href="/" class="mobile-nav-item active">
      <span class="icon">🏠</span>
      <span>Home</span>
    </a>
    <a href="/cart" class="mobile-nav-item">
      <span class="icon">🛒</span>
      <span>Cart (<%= cartCount %>)</span>
    </a>
    <% if (currentUser) { %>
      <a href="/logout" class="mobile-nav-item">
        <span class="icon">🚪</span>
        <span>Logout</span>
      </a>
    <% } else { %>
      <a href="/login" class="mobile-nav-item">
        <span class="icon">👤</span>
        <span>Account</span>
      </a>
    <% } %>
  </nav>

</body>
</html>